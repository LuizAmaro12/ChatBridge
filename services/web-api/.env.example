# Referência: exportar no terminal; dotnet não lê este arquivo automaticamente.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5001
Auth__Issuer=chatbridge-web
Auth__Audience=chatbridge-web-client
Auth__SigningKey=
Auth__TokenSeconds=3600
DemoUser__Username=web-demo
DemoUser__Name=Usuário Web
DemoUser__Password=
Interbackend__Url=ws://localhost:5002/internal/ws
Interbackend__ServiceKey=
Interbackend__AckTimeoutSeconds=5
Interbackend__HeartbeatSeconds=10
Chat__RetentionSeconds=600
Chat__CacheLimit=10000
Chat__MaxClients=100
Cors__AllowedOrigin=http://localhost:3000
